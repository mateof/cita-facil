###############################################################################
# CitaFácil - configuración
#
# Copia este fichero a `.env` y ajusta lo que necesites. Todo lo que no se
# indique toma el valor por defecto que aparece comentado, así que una
# instalación básica solo necesita definir APP_SECRET y APP_URL.
###############################################################################

# ------------------------------------------------------------------- General
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# URL pública. Se usa en los enlaces de los correos, en los QR y en los
# webhooks, así que tiene que ser la que ve el usuario, no la interna.
APP_URL=http://localhost:3000
APP_NAME=CitaFácil

# Clave maestra: firma los tokens de sesión y cifra las credenciales de las
# pasarelas de pago guardadas en base de datos. OBLIGATORIA en producción.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

LOG_LEVEL=info
# LOG_LEVEL=debug para ver también las consultas si DB_LOG_QUERIES=true

# Orígenes permitidos por CORS. Vacío = solo el mismo origen, que es lo
# habitual porque el frontend va integrado.
# CORS_ORIGINS=https://otra-app.ejemplo.es

# Activar si hay un proxy inverso delante (nginx, Traefik, Cloudflare).
TRUST_PROXY=true

# Servir el frontend compilado desde el propio proceso del API.
SERVE_WEB=true
# WEB_DIST_PATH=/app/packages/web/dist

DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=Europe/Madrid
DATA_DIR=./data

# ------------------------------------------------------------- Base de datos
# Motores admitidos: sqlite | postgres | mysql | mariadb | mssql
DB_CLIENT=sqlite

# SQLite (por defecto, sin instalación ni servicios externos)
DB_FILE=./data/cita-facil.sqlite

# Resto de motores
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=citafacil
# DB_USER=citafacil
# DB_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MIN=0
# DB_POOL_MAX=10

# Aplica las migraciones pendientes al arrancar. Si la base está vacía, crea
# el esquema completo; si ya existe, solo ejecuta lo que falte.
DB_AUTO_MIGRATE=true

# Carga datos de ejemplo cuando no hay ninguna organización.
DB_AUTO_SEED=false
DB_LOG_QUERIES=false

# ----------------------------------------------------------------- Seguridad
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_COOKIE_NAME=cf_session
# Poner a true cuando se sirva por HTTPS (obligatorio en producción).
COOKIE_SECURE=false
# COOKIE_DOMAIN=.ejemplo.es

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
PASSWORD_MIN_LENGTH=10

# ----------------------------------------------------------------------- Redis
# Opcional y desactivado por defecto. La aplicación funciona igual sin él: las
# sesiones viven en la base de datos y sobreviven a los reinicios con o sin
# Redis. Lo que aporta es compartir el cupo del limitador entre instancias y
# evitar una consulta por petición para comprobar la sesión.
#
# Hace falta cuando se levantan varias instancias detrás de un balanceador; con
# una sola es opcional. Si se configura y no responde, se registra un aviso y se
# sigue funcionando sin él.
#
# En docker compose: descomenta esta línea y arranca con --profile redis.
# REDIS_URL=redis://redis:6379
# Prefijo de las claves, por si el Redis es compartido con otras aplicaciones.
REDIS_PREFIX=cf:
# Segundos que se cachea el estado de una sesión. 0 desactiva solo esa caché.
REDIS_SESSION_TTL=60

# Métodos de acceso habilitados DE FÁBRICA: password, passkey, certificate,
# oidc, google. A partir del primer cambio en el panel (Acceso y registro) manda
# lo guardado en base de datos y esta variable deja de tener efecto.
AUTH_METHODS=password,passkey,certificate

# Política de alta inicial, también editable después desde el panel:
#   open        cualquiera puede registrarse
#   allowlist   solo las personas de la lista de autorizados
#   invite_only solo cuentas creadas por el administrador
#   closed      no se admiten altas nuevas
REGISTRATION_MODE=open

# Tope de la instalación para reservar sin cuenta. Cada organización decide
# después si lo usa, pero no puede saltárselo.
ALLOW_ANONYMOUS_BOOKING=true

MFA_REQUIRED_FOR_ADMINS=false
MFA_TRUSTED_DEVICE_DAYS=30

# ---------------------------------------------- DNI electrónico y certificado
# Cabeceras que rellena el proxy inverso tras el saludo TLS con certificado
# de cliente. Ver docker/nginx/nginx.conf y docs/autenticacion.md.
CERT_HEADER=x-client-cert
CERT_VERIFY_HEADER=x-client-verify

# Directorio con las CA de confianza en PEM (raíz e intermedias del DNIe y de
# la FNMT). Sin certificados aquí, el acceso por certificado rechaza todo.
CERT_TRUST_DIR=./config/trust

# Comprobación de revocación por CRL. Descarga y cachea las listas.
CERT_CHECK_CRL=false
CERT_CRL_DIR=./data/crl
CERT_CRL_REFRESH_HOURS=24

# Solo para desarrollo: permite mandar el certificado en el cuerpo.
CERT_AUTH_ALLOW_BODY=false

# Crea la cuenta automáticamente la primera vez que entra un certificado válido.
CERT_AUTO_PROVISION=true

# ------------------------------------------------------------ Cl@ve u OIDC
# OIDC_ISSUER=https://se-pasarela.clave.gob.es/...
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://citas.ejemplo.es/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_LABEL=Cl@ve

# ------------------------------------------------------------- Google OAuth2
# Crea un cliente OAuth 2.0 de tipo "aplicación web" en Google Cloud
# (APIs y servicios -> Credenciales) y da de alta como URI de retorno:
#   <APP_URL>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Restringe el acceso a cuentas de estos dominios de Google Workspace:
# GOOGLE_HOSTED_DOMAINS=miempresa.com

# ------------------------------------------------------------------ WebAuthn
# Se derivan de APP_URL si no se indican. Fíjalos si sirves varios dominios.
# WEBAUTHN_RP_ID=citas.ejemplo.es
# WEBAUTHN_ORIGIN=https://citas.ejemplo.es
# WEBAUTHN_RP_NAME=CitaFácil

# -------------------------------------------------------------------- Correo
MAIL_ENABLED=true
# smtp = envío real | json = se escribe en el log (desarrollo) | none = desactivado
MAIL_TRANSPORT=json
# SMTP_HOST=smtp.ejemplo.es
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=CitaFácil <no-reply@ejemplo.es>
# MAIL_REPLY_TO=citas@ejemplo.es

# ------------------------------------------------------ Notificaciones push
PUSH_ENABLED=false

# Firebase Cloud Messaging (aplicaciones móviles)
# FCM_SERVICE_ACCOUNT_FILE=/data/firebase.json
# o el mismo JSON en base64:
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_PROJECT_ID=

# Web Push para la PWA. Genera el par de claves con:
#   npx web-push generate-vapid-keys
# WEBPUSH_PUBLIC_KEY=
# WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@ejemplo.es

# ------------------------------------------------------------------ Telegram
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=citas_ejemplo_bot
# TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------ WhatsApp
# API oficial de Meta (WhatsApp Cloud API)
WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=

# ----------------------------------------------------------------------- SMS
SMS_ENABLED=false
SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+34600000000

# --------------------------------------------------------------------- Pagos
PAYMENTS_ENABLED=false
PAYMENTS_DEFAULT_PROVIDER=stripe

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=001
# REDSYS_SECRET_KEY=
# REDSYS_ENVIRONMENT=test

# ------------------------------------------------------------------- Backups
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
# Todos los días a las 3:30
BACKUP_CRON=30 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=60
# Cifra la copia con AES-256-GCM usando una clave derivada de APP_SECRET.
# Ojo: sin APP_SECRET no se puede restaurar.
BACKUP_ENCRYPT=false

# ------------------------------------------------------------- Integraciones
MCP_ENABLED=true
ALEXA_ENABLED=false
# ALEXA_SKILL_ID=amzn1.ask.skill.xxxx
GOOGLE_ASSISTANT_ENABLED=false
# GOOGLE_PROJECT_ID=
PUBLIC_API_ENABLED=true
WEBHOOKS_ENABLED=true

# -------------------------------------------------------------- Planificador
# Desactívalo en todas las instancias menos una si hay varias replicas.
SCHEDULER_ENABLED=true
NOTIFICATION_DISPATCH_CRON=* * * * *
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=50

# ------------------------------------------------------ Primer administrador
# Si se indican, se crea al arrancar por primera vez.
# BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.es
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ORG_NAME=Mi establecimiento
